# Financial Modeling Prep — https://site.financialmodelingprep.com/developer/docs
# Used only for live price + market cap via the free /profile endpoint. Sign up for the
# free tier, paste the key here, then add the same key to Vercel:
# Project Settings -> Environment Variables -> FMP_API_KEY
FMP_API_KEY=your_key_here

# SEC EDGAR (financial statements) needs no key, but requires a contact email in the
# User-Agent header. Optional — a default is used if unset. Format: "Name email@domain".
# SEC_USER_AGENT=Your Name your@email.com
